# Copy this file to .env (setup_windows.ps1 does it for you) or fill keys in on the Settings page.
# .env stays on your computer. Never commit it.

# Required for YouTube coverage checks and competitor tracking.
# Google Cloud Console -> APIs & Services -> Library -> "YouTube Data API v3" -> Enable
# then Credentials -> Create credentials -> API key (restrict it to YouTube Data API v3).
YOUTUBE_API_KEY=

# Optional AI assistance (summaries, interest/footage estimates, request polishing).
# AI_PROVIDER = anthropic | openai | (blank = disabled; the app works fully without AI)
AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model override, e.g. claude-sonnet-4-5 or gpt-4o-mini
AI_MODEL=

# Optional: Brave Search API key - helps find agency websites that are not on obvious .gov domains.
BRAVE_SEARCH_API_KEY=

# Optional: where the SQLite database and run logs live.
# Default on Windows: %LOCALAPPDATA%\BodycamResearchHub (kept out of OneDrive on purpose).
# BCH_DATA_DIR=
# BCH_DB_PATH=
